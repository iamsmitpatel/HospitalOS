# Server
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api

# Database (Prisma)
DATABASE_URL="postgresql://hospitalos:hospitalos_dev_password@localhost:5432/hospitalos_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_REFRESH_TTL="7d"

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN="http://localhost:3001"

# Rate limiting (auth endpoints: login/register/register-patient/refresh)
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# Rate limiting (every other endpoint — blunts flooding, not normal use)
DEFAULT_THROTTLE_TTL_SECONDS=60
DEFAULT_THROTTLE_LIMIT=120
