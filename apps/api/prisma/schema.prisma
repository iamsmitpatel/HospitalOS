// HospitalOS - Phase 1 (Foundation) + Phase 1B (Patient) + Phase 3 (Hospital
// Operations Core) + Phase 4 (Clinical/Laboratory/Pharmacy/Financial Core) schema.
// Scope: tenancy (Hospital), identity (User), auth session state (RefreshToken),
// AuditLog, Patient/MRN, Department, DoctorProfile/Schedule/Unavailability,
// Appointment, Queue/QueueEntry, Encounter/VitalSigns/ClinicalNote/Diagnosis/
// Prescription, LabTest/LabOrder/LabResult, Medicine/StockBatch/StockMovement/
// DispenseRecord, Service/ServicePrice/Invoice/InvoiceItem, Payment/Refund.
// AI diagnosis, insurance automation, advanced accounting, telemedicine, and
// HospitalOS Connect are deliberately out of scope until their respective
// phases (see /DECISIONS.md and the master roadmap).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  LAB_TECHNICIAN
  ACCOUNTANT
  PATIENT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Deliberately smaller than the master doc's full example list for this
// phase's actually-implemented flow (see /DECISIONS.md): CHECKED_IN exists
// for future granularity but Phase 3's check-in action moves a caller
// straight from SCHEDULED/CONFIRMED to IN_QUEUE, creating the QueueEntry in
// the same transaction.
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_QUEUE
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueEntryStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
  CANCELLED
}

// Created directly as IN_PROGRESS in practice — OPEN exists for future
// granularity but has no Phase 4 trigger, same pattern as Phase 3's unused
// CHECKED_IN. See /DECISIONS.md.
enum EncounterStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Shared shape for Diagnosis and Prescription (two separate enums, not one
// shared type, so each state machine can evolve independently even though
// today's values match): a record is mutable only while DRAFT, immutable
// once FINALIZED, and corrections after that create a new row via the
// amendedFromId chain rather than overwriting (master doc §14/§16/§20/§33).
enum DiagnosisStatus {
  DRAFT
  FINALIZED
  AMENDED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  FINALIZED
  AMENDED
  CANCELLED
}

enum LabOrderStatus {
  ORDERED
  COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum LabOrderItemStatus {
  ORDERED
  COLLECTED
  COMPLETED
  CANCELLED
}

// Entered -> Reviewed -> Verified is the master doc §32 workflow; a result
// should not become final merely because someone typed a value in.
enum LabResultStatus {
  ENTERED
  REVIEWED
  VERIFIED
  AMENDED
}

enum LabResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
}

enum StockBatchStatus {
  ACTIVE
  EXPIRED
  DEPLETED
}

enum StockMovementType {
  PURCHASE
  ADJUSTMENT
  DISPENSE
  RETURN
  EXPIRED
  TRANSFER
}

enum ServiceCategory {
  CONSULTATION
  LABORATORY
  PROCEDURE
  IMAGING
  PHARMACY
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

// Phase 4 has no real payment gateway integration (none is in scope — see
// /DECISIONS.md), so payments are created directly as SUCCESS by staff
// confirming receipt (e.g. cash handed over, card charged on a separate POS
// terminal). PENDING/FAILED are modeled for a future gateway integration but
// are not reachable via any Phase 4 endpoint today.
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Hospital {
  id       String @id @default(uuid())
  name     String
  slug     String @unique

  // Short uppercase identifier used as the MRN prefix (e.g. "SUN" -> SUN-000001).
  // Set once at hospital creation; not editable afterward (changing it would
  // make previously issued MRNs inconsistent with newly issued ones).
  code     String @unique

  // Monotonic per-hospital counter backing MRN generation. Incremented via a
  // single atomic UPDATE (Prisma `increment`) inside the transaction that
  // creates the patient, so concurrent registrations never hand out the same
  // MRN twice — see patients/patients.service.ts and /DECISIONS.md.
  mrnSequence Int    @default(0)

  // Monotonic per-hospital counter backing invoice numbering — identical
  // atomic-increment pattern to mrnSequence above, see invoices.service.ts.
  invoiceSequence Int @default(0)

  // IANA timezone name. HospitalOS targets India initially (master doc §34);
  // defaulting here rather than requiring every hospital to set it explicitly
  // keeps onboarding simple while still making the field explicit and
  // overridable per hospital. All DoctorSchedule wall-clock times are
  // interpreted in this timezone — see /DATABASE.md.
  timezone String @default("Asia/Kolkata")

  // --- HospitalOS Connect public discovery (Phase 5) ---------------------
  // Defaults to false: an existing hospital never becomes publicly
  // discoverable just because this column was added — a HOSPITAL_ADMIN (or
  // SUPER_ADMIN) must explicitly opt in via PATCH /hospitals/:id/public-profile.
  // Only the fields below are ever exposed by the public discovery
  // endpoints; everything else on this model (mrnSequence, invoiceSequence,
  // internal ids, etc.) never is, isPublic or not — see connect/discovery
  // services and /SECURITY.md.
  isPublic          Boolean @default(false)
  publicDescription String?
  addressLine       String?
  city              String?
  publicPhone       String?
  publicEmail       String?
  // Free text (e.g. "Mon-Sat 9:00-18:00") rather than a structured weekly
  // table — same "do not build all of this immediately" judgment as
  // Patient.addressLine in Phase 1B. A structured DoctorSchedule-style table
  // already exists for actual slot computation; this is display-only.
  operatingHours    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  patients        Patient[]
  auditLogs       AuditLog[]
  departments     Department[]
  doctorProfiles  DoctorProfile[]
  appointments    Appointment[]
  queues          Queue[]
  encounters      Encounter[]
  vitalSigns      VitalSigns[]
  clinicalNotes   ClinicalNote[]
  diagnoses       Diagnosis[]
  prescriptions   Prescription[]
  labTests        LabTest[]
  labOrders       LabOrder[]
  labResults      LabResult[]
  medicines       Medicine[]
  stockBatches    StockBatch[]
  stockMovements  StockMovement[]
  dispenseRecords DispenseRecord[]
  services        Service[]
  servicePrices   ServicePrice[]
  invoices        Invoice[]
  payments        Payment[]
  refunds         Refund[]

  @@map("hospitals")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // HospitalOS Connect (Phase 5): baseline identity for a PATIENT account,
  // independent of any specific hospital's Patient record — a Connect user
  // may book at several hospitals, each creating/linking its own Patient
  // row (with its own MRN), but "who this person is" has exactly one
  // source of truth here rather than being duplicated-and-possibly-
  // divergent across every hospital they've visited. Always null for staff
  // roles; never required at the Prisma level (no role-conditional NOT NULL
  // — same reasoning as hospitalId above) so this column costs nothing for
  // the staff identities that don't use it.
  phone       String?
  dateOfBirth DateTime? @db.Date
  gender      Gender?

  // Null only for SUPER_ADMIN, who is not scoped to a single hospital.
  // Enforced at the application layer (see users/users.service.ts) since
  // Prisma cannot express a conditional NOT NULL constraint declaratively.
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  registeredPatients Patient[] @relation("PatientRegisteredBy")
  doctorProfile      DoctorProfile?

  // HospitalOS Connect (Phase 5): the clinical Patient record(s) this
  // identity is linked to — at most one per hospital (Patient.userId is
  // unique), but a single Connect account may be linked to several across
  // different hospitals (one MRN per hospital visited). See
  // connect/patient-profile.service.ts and /DECISIONS.md.
  patientRecords Patient[] @relation("PatientConnectAccount")

  @@index([hospitalId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Auth session state
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the raw refresh token string. Deterministic (not bcrypt) because
  // the token must be looked up by exact match; the JWT signature is the
  // primary authenticity guarantee, this hash backs revocation/reuse checks.
  tokenHash String    @unique

  expiresAt DateTime
  revokedAt DateTime?

  // Points to the token that replaced this one when rotated, forming a chain
  // used to detect refresh-token reuse (a revoked token presented again).
  replacedByTokenId String?

  createdByIp String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Patient
// ---------------------------------------------------------------------------

model Patient {
  id         String   @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  // Hospital-scoped identifier, e.g. "SUN-000001". Unique per hospital, not
  // globally — see the @@unique below and /DATABASE.md for why, and
  // patients.service.ts for the atomic generation logic. Immutable once set.
  mrn String

  firstName String
  lastName  String
  dateOfBirth DateTime @db.Date
  gender      Gender

  phone String
  email String?

  // A single free-text line rather than a structured address table — Phase 1B
  // deliberately keeps this minimal (master doc §18: "do not build all of
  // these immediately"). A normalized PatientAddress model is a reasonable
  // later addition if/when it's actually needed (e.g. multi-address support).
  addressLine String?

  emergencyContactName  String?
  emergencyContactPhone String?

  isActive Boolean @default(true)

  registeredByUserId String
  registeredBy       User   @relation("PatientRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: Restrict)

  // HospitalOS Connect (Phase 5): the patient's own login identity, if
  // they've linked this record to a Connect account — nullable (most
  // historical records predate Connect and are never claimed). Unique only
  // PER HOSPITAL (see @@unique([hospitalId, userId]) below), not globally:
  // one Connect account legitimately links to one Patient row at EACH
  // hospital it has visited (one MRN each), so a bare @unique here would
  // have made a second hospital's booking fail outright the moment a
  // patient already had a linked record anywhere else — caught during the
  // Phase 5 database-integrity audit before it shipped, see /DECISIONS.md.
  // Linking happens via an explicit, server-validated claim (exact MRN +
  // DOB + phone match) or auto-creation on first booking at a hospital,
  // never implicitly — see patients.service.ts and /SECURITY.md ("never
  // accept patientId from the frontend and trust it").
  userId String?
  user   User?   @relation("PatientConnectAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  queueEntries QueueEntry[]
  encounters      Encounter[]
  vitalSigns      VitalSigns[]
  clinicalNotes   ClinicalNote[]
  diagnoses       Diagnosis[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  labResults      LabResult[]
  invoices        Invoice[]
  dispenseRecords DispenseRecord[]

  @@unique([hospitalId, mrn])
  // One linked Patient row per Connect account PER HOSPITAL — see the
  // comment on `userId` above. Multiple NULLs are allowed (Postgres treats
  // NULL as distinct from NULL in a unique index), so every pre-Connect,
  // never-claimed record is completely unaffected.
  @@unique([hospitalId, userId])
  @@index([hospitalId, lastName, firstName])
  @@index([hospitalId, phone])
  @@map("patients")
}

// ---------------------------------------------------------------------------
// Hospital operations: Department, Doctor, Schedule
// ---------------------------------------------------------------------------

model Department {
  id         String @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  name        String
  // Short code, e.g. "CARD" for Cardiology. Unique per hospital, not globally.
  code        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfiles DoctorProfile[]
  appointments   Appointment[]
  queues         Queue[]
  encounters     Encounter[]

  @@unique([hospitalId, code])
  @@unique([hospitalId, name])
  @@index([hospitalId])
  @@map("departments")
}

model DoctorProfile {
  id String @id @default(uuid())

  // One DoctorProfile per User (master doc §11: a doctor is a User plus a
  // DoctorProfile, not a separate identity). The User must already exist
  // with role=DOCTOR before a profile can be attached — see doctors.service.ts.
  userId String   @unique
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  specialization String
  displayName    String

  // Professional registration/license identifier. Optional (not every
  // deployment context has one on file at onboarding time), format NOT
  // validated beyond basic length/charset (master doc §13: "do not assume a
  // universal format," "do not claim regulatory verification"). Unique per
  // hospital, not globally — see /DECISIONS.md.
  registrationNumber String?

  status DoctorStatus @default(ACTIVE)

  // HospitalOS Connect (Phase 5): per-doctor opt-out of public listing,
  // independent of Hospital.isPublic — "doctor profiles must respect
  // hospital configuration" (master doc) means a doctor is only ever
  // listable when BOTH this is true AND the owning hospital is public.
  // Defaults true so existing doctors are listable the moment their
  // hospital opts in, without a second manual step per doctor.
  isPubliclyVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules        DoctorSchedule[]
  unavailabilities DoctorUnavailability[]
  appointments     Appointment[]
  queues           Queue[]
  encounters       Encounter[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]

  @@unique([hospitalId, registrationNumber])
  @@index([hospitalId, departmentId])
  @@map("doctor_profiles")
}

model DoctorSchedule {
  id              String        @id @default(uuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek

  // Wall-clock "HH:mm" (24h), interpreted in the owning Hospital's timezone
  // (master doc §34) — NOT a DateTime, because this is a recurring weekly
  // pattern independent of any specific calendar date or DST transition.
  startTime String
  endTime   String

  slotDurationMinutes Int     @default(15)
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorProfileId, dayOfWeek])
  @@map("doctor_schedules")
}

model DoctorUnavailability {
  id              String        @id @default(uuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  // Absolute instants (leave/holiday/blocked time is date-specific, unlike
  // the recurring DoctorSchedule above).
  startAt DateTime
  endAt   DateTime
  reason  String?

  createdAt DateTime @default(now())

  @@index([doctorProfileId, startAt, endAt])
  @@map("doctor_unavailabilities")
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

model Appointment {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Absolute UTC instant. Conflict prevention (master doc §37/§38/§79) is a
  // partial unique index added by hand to the migration SQL — Prisma's
  // schema DSL cannot express "unique only when status is active," so it is
  // not visible here. See /DATABASE.md for the exact constraint and why.
  scheduledAt     DateTime
  durationMinutes Int      @default(15)

  status AppointmentStatus @default(SCHEDULED)

  // Patient-provided reason for the visit only (e.g. "annual checkup") —
  // never a diagnosis or clinical note; those are out of scope until a later
  // phase (master doc §3).
  reason String?

  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?

  // Points at the OLD appointment this one replaced via reschedule, forming
  // a traceable chain rather than overwriting history (master doc §42/§43).
  rescheduledFromId String?      @unique
  rescheduledFrom   Appointment? @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Appointment? @relation("AppointmentReschedule")

  bookedByUserId String

  // HospitalOS Connect (Phase 5): client-supplied idempotency key for
  // patient-initiated booking, same two-layer pattern (pre-check + unique-
  // constraint backstop) already proven for Payment.idempotencyKey — a
  // retried booking request with the same key returns the original
  // appointment instead of attempting a second booking. Nullable so
  // staff-side bookings (which never supply one) aren't constrained against
  // each other (Postgres treats multiple NULLs in a unique index as
  // distinct, same reasoning as Payment's).
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queueEntry QueueEntry?
  encounter  Encounter?

  @@unique([hospitalId, idempotencyKey])
  @@index([hospitalId, doctorProfileId, scheduledAt])
  @@index([hospitalId, patientId])
  @@index([hospitalId, status])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Queue
// ---------------------------------------------------------------------------

model Queue {
  id         String @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  doctorProfileId String?
  doctorProfile   DoctorProfile? @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)

  // The operating day this queue represents. One queue per doctor per day,
  // get-or-created on first check-in rather than requiring a separate manual
  // creation step — see /DECISIONS.md.
  queueDate DateTime @db.Date

  // Atomic per-queue token counter, same pattern as Hospital.mrnSequence —
  // incremented via a transactional UPDATE ... increment when a QueueEntry
  // is created, so concurrent check-ins never collide (master doc §47).
  nextTokenNumber Int @default(1)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries QueueEntry[]

  @@unique([hospitalId, doctorProfileId, queueDate])
  @@index([hospitalId, queueDate])
  @@map("queues")
}

model QueueEntry {
  id      String @id @default(uuid())
  queueId String
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  tokenNumber Int

  status QueueEntryStatus @default(WAITING)

  // 0 = normal. Higher = more urgent. Staff-assigned only — see
  // queue.service.ts and /SECURITY.md (master doc §49: patients cannot
  // self-assign priority).
  priority Int @default(0)

  joinedAt       DateTime  @default(now())
  calledAt       DateTime?
  calledByUserId String?
  completedAt    DateTime?
  skippedAt      DateTime?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([queueId, tokenNumber])
  @@index([queueId, status])
  // Added in Phase 5: HospitalOS Connect's patient-queue.service.ts filters
  // QueueEntry by a Patient.userId relation (a Connect patient's own active
  // entries) — that join lands on this FK, which until now had no index of
  // its own (Postgres never auto-indexes a foreign key column). Without
  // this, "where is my queue entry" degrades to a sequential scan as
  // queue_entries grows. See /DATABASE.md.
  @@index([patientId])
  @@map("queue_entries")
}

// ---------------------------------------------------------------------------
// Clinical: Encounter, Vitals, Clinical Notes, Diagnosis, Prescription
// ---------------------------------------------------------------------------

model Encounter {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Optional: an encounter can be created directly (walk-in) without a prior
  // appointment, though the normal flow is Appointment -> check-in -> Queue
  // -> Encounter (master doc §9). When present, patient/doctor/department
  // above are server-derived FROM the appointment, never trusted from the
  // request body — see encounters.service.ts.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  status EncounterStatus @default(IN_PROGRESS)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vitalSigns    VitalSigns[]
  clinicalNotes ClinicalNote[]
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  invoices      Invoice[]

  @@index([hospitalId, patientId])
  @@index([hospitalId, doctorProfileId])
  @@index([hospitalId, status])
  @@map("encounters")
}

model VitalSigns {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  // Structured, typed fields rather than free text (master doc §11). All
  // optional — a given observation round may not capture every measurement.
  // Storage ranges are enforced in the DTO (plausible physiological bounds,
  // not a rejection of unusual-but-real values — master doc §12); clinical
  // judgment belongs to clinicians, not this layer.
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRateBpm            Int?
  temperatureCelsius      Decimal? @db.Decimal(4, 1)
  respiratoryRate         Int?
  oxygenSaturationPercent Int?
  weightKg                Decimal? @db.Decimal(5, 2)
  heightCm                Decimal? @db.Decimal(5, 1)

  recordedByUserId String
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([hospitalId, encounterId])
  @@index([hospitalId, patientId])
  @@map("vital_signs")
}

model ClinicalNote {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  // Structured SOAP-style sections (master doc §13). "plan" also captures
  // the treatment plan — a separate TreatmentPlan model would duplicate
  // this field for no structural benefit; see /DECISIONS.md.
  chiefComplaint String?
  history        String?
  examination    String?
  assessment     String?
  plan           String?

  authorUserId String

  // Append-only: there is deliberately no update endpoint for an existing
  // note (master doc §14 — "a later correction should not erase the fact
  // that an earlier record existed"). A correction creates a NEW row
  // referencing the one it supersedes, never mutates the original.
  correctsId  String?       @unique
  corrects    ClinicalNote? @relation("ClinicalNoteCorrection", fields: [correctsId], references: [id], onDelete: SetNull)
  correctedBy ClinicalNote? @relation("ClinicalNoteCorrection")

  createdAt DateTime @default(now())

  @@index([hospitalId, encounterId])
  @@index([hospitalId, patientId])
  @@map("clinical_notes")
}

model Diagnosis {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  description String

  // Free-text, optional external code (e.g. an ICD-10 code the clinician
  // already knows) — never validated against or auto-populated from a real
  // coding system, which this platform does not implement (master doc §15:
  // "do not invent medical codes").
  diagnosisCode String?
  // e.g. "primary"/"secondary"/"differential" — free text, not an enum, to
  // avoid prematurely fixing a taxonomy nothing requires yet.
  type          String?

  status DiagnosisStatus @default(DRAFT)

  recordedByUserId String
  recordedAt       DateTime  @default(now())
  finalizedAt      DateTime?

  // Same amendment-chain pattern as Appointment.rescheduledFromId (Phase 3):
  // a correction after finalization creates a new row; the old one is
  // marked AMENDED, never overwritten (master doc §16/§33).
  amendedFromId String?     @unique
  amendedFrom   Diagnosis?  @relation("DiagnosisAmendment", fields: [amendedFromId], references: [id], onDelete: SetNull)
  amendedTo     Diagnosis?  @relation("DiagnosisAmendment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, encounterId])
  @@index([hospitalId, patientId])
  @@map("diagnoses")
}

model Prescription {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  status PrescriptionStatus @default(DRAFT)
  notes  String?

  // Same amendment-chain pattern as Diagnosis/Appointment — see above.
  amendedFromId String?        @unique
  amendedFrom   Prescription?  @relation("PrescriptionAmendment", fields: [amendedFromId], references: [id], onDelete: SetNull)
  amendedTo     Prescription?  @relation("PrescriptionAmendment")

  createdByUserId String
  finalizedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PrescriptionItem[]

  @@index([hospitalId, encounterId])
  @@index([hospitalId, patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id String @id @default(uuid())

  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  dosage       String
  frequency    String
  duration     String
  route        String?
  instructions String?
  quantity     Int

  createdAt DateTime @default(now())

  dispenseRecords DispenseRecord[]

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ---------------------------------------------------------------------------
// Laboratory: Test Catalog, Order, Result
// ---------------------------------------------------------------------------

model LabTest {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  name       String
  code       String
  category   String?
  sampleType String?
  unit       String?

  // Optional numeric reference range for tests with a single expected
  // numeric band. LabResult.referenceRange (free text) covers qualitative
  // or multi-range tests this pair can't express — see /DATABASE.md.
  referenceRangeLow  Decimal? @db.Decimal(10, 3)
  referenceRangeHigh Decimal? @db.Decimal(10, 3)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems LabOrderItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@map("lab_tests")
}

model LabOrder {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  status LabOrderStatus @default(ORDERED)

  orderedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LabOrderItem[]

  @@index([hospitalId, patientId])
  @@index([hospitalId, status])
  @@map("lab_orders")
}

model LabOrderItem {
  id String @id @default(uuid())

  labOrderId String
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  labTestId String
  labTest   LabTest @relation(fields: [labTestId], references: [id], onDelete: Restrict)

  status LabOrderItemStatus @default(ORDERED)

  // Specimen tracking folded directly onto the order item rather than a
  // separate Specimen table — one specimen maps to one ordered test in this
  // phase's scope, and a join table added no benefit (master doc §30: "do
  // not create unnecessary specimen complexity"). See /DECISIONS.md.
  specimenType      String?
  collectedAt       DateTime?
  collectedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result LabResult?

  @@index([labOrderId])
  @@index([labTestId])
  @@map("lab_order_items")
}

model LabResult {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  labOrderItemId String       @unique
  labOrderItem   LabOrderItem @relation(fields: [labOrderItemId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  value String
  unit  String?
  // Snapshot of the test's reference range at result-entry time, not a live
  // join to LabTest — never recomputed from a possibly-changed catalog
  // value later (the same historical-value-preservation principle master
  // doc §38 states for billing, applied here too).
  referenceRange String?
  flag           LabResultFlag?

  status LabResultStatus @default(ENTERED)

  enteredByUserId String
  enteredAt       DateTime @default(now())

  // Maker-checker: verifiedByUserId must differ from enteredByUserId,
  // enforced in lab.service.ts, not just by convention (master doc §32).
  verifiedByUserId String?
  verifiedAt       DateTime?

  // Same amendment-chain pattern as Diagnosis/Prescription — a correction
  // to a VERIFIED result creates a new row rather than overwriting it
  // (master doc §33).
  amendsId  String?     @unique
  amends    LabResult?  @relation("LabResultAmendment", fields: [amendsId], references: [id], onDelete: SetNull)
  amendedBy LabResult?  @relation("LabResultAmendment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, patientId])
  @@map("lab_results")
}

// ---------------------------------------------------------------------------
// Pharmacy: Medicine Catalog, Batch Inventory, Dispensing
// ---------------------------------------------------------------------------

model Medicine {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  name        String
  genericName String?
  brandName   String?
  strength    String?
  // e.g. "tablet", "syrup", "injection" — free text, not an enum: the set of
  // forms varies by hospital and this platform doesn't claim to enumerate
  // every pharmaceutical dosage form (master doc §21).
  form        String?
  unit        String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockBatches      StockBatch[]
  stockMovements    StockMovement[]
  prescriptionItems PrescriptionItem[]

  @@index([hospitalId, name])
  @@map("medicines")
}

model StockBatch {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  batchNumber String

  quantityReceived Int
  // Live balance, decremented atomically on dispense via a conditional
  // UPDATE ... WHERE quantityRemaining >= $qty (master doc §24/§25) — a
  // hand-added CHECK constraint additionally enforces quantityRemaining >= 0
  // at the database level as a backstop; see /DATABASE.md.
  quantityRemaining Int

  expiryDate    DateTime @db.Date
  purchasePrice Decimal? @db.Decimal(10, 2)

  status StockBatchStatus @default(ACTIVE)

  receivedAt      DateTime @default(now())
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stockMovements  StockMovement[]
  dispenseRecords DispenseRecord[]

  @@unique([hospitalId, medicineId, batchNumber])
  @@index([hospitalId, medicineId, expiryDate])
  @@index([hospitalId, status])
  @@map("stock_batches")
}

model StockMovement {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  stockBatchId String
  stockBatch   StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  type StockMovementType

  // Signed: positive for increases (PURCHASE/RETURN/an upward ADJUSTMENT),
  // negative for decreases (DISPENSE/EXPIRED/TRANSFER/a downward
  // ADJUSTMENT) — one field covers every movement type unambiguously and
  // makes "current stock = sum of movements" trivially true (master doc §23).
  quantityDelta Int

  // Loose pointer, not an enforced FK — the referenced entity varies by
  // movement type (e.g. a DispenseRecord id for DISPENSE movements).
  referenceType String?
  referenceId   String?
  notes         String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([hospitalId, medicineId, createdAt])
  @@index([stockBatchId])
  @@map("stock_movements")
}

model DispenseRecord {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Restrict)

  stockBatchId String
  stockBatch   StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  quantity Int

  dispensedByUserId String
  dispensedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([hospitalId, patientId])
  @@index([prescriptionItemId])
  @@map("dispense_records")
}

// ---------------------------------------------------------------------------
// Billing: Service Catalog, Pricing, Invoice
// ---------------------------------------------------------------------------

model Service {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  name     String
  code     String
  category ServiceCategory @default(OTHER)
  isActive Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices       ServicePrice[]
  invoiceItems InvoiceItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
  @@map("services")
}

model ServicePrice {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  // The "current" price is the row with effectiveTo = null. Creating a new
  // price closes out the previous one's effectiveTo in the same transaction
  // (billing.service.ts) — never mutates an existing price in place, and
  // never affects InvoiceItems already created against the old price
  // (master doc §37/§38).
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  @@index([hospitalId, serviceId, effectiveTo])
  @@map("service_prices")
}

model Invoice {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  // Hospital-scoped, human-readable — same atomic-counter pattern as MRN/
  // queue tokens (Hospital.invoiceSequence). Not globally unique.
  invoiceNumber String

  status InvoiceStatus @default(DRAFT)

  // All monetary fields use Decimal, never float/Int-as-cents shortcuts
  // (master doc §40). See /DATABASE.md for the exact calculation and
  // rounding policy. Hand-added CHECK constraints enforce total >= 0,
  // amountPaid >= 0, amountRefunded >= 0 at the database level (master doc §44).
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 4)
  taxAmount      Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  // Running balances, updated transactionally alongside Payment/Refund
  // creation — not recomputed by summing on every read.
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  amountRefunded Decimal @default(0) @db.Decimal(12, 2)

  currency String @default("INR")

  issuedAt        DateTime?
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  refunds  Refund[]

  @@unique([hospitalId, invoiceNumber])
  @@index([hospitalId, patientId])
  @@index([hospitalId, status])
  @@map("invoices")
}

model InvoiceItem {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Nullable, loose reference only — the fields below are the historical
  // source of truth (master doc §41), never reconstructed by joining back
  // to the live Service/ServicePrice catalog.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod
  status PaymentStatus @default(SUCCESS)

  // External/physical-terminal transaction reference only — never a raw
  // card number or CVV (master doc §48; neither is ever stored anywhere in
  // this schema).
  referenceNumber String?

  // Client-supplied, unique per hospital when present — a retried request
  // with the same key returns the original payment instead of creating a
  // second one (master doc §47). Nullable so calls without a key aren't
  // constrained against each other (Postgres treats multiple NULLs in a
  // unique index as distinct).
  idempotencyKey String?

  createdByUserId String
  createdAt       DateTime @default(now())

  refunds Refund[]

  @@unique([hospitalId, idempotencyKey])
  @@index([hospitalId, invoiceId])
  @@index([hospitalId, status])
  @@map("payments")
}

model Refund {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  amount Decimal      @db.Decimal(12, 2)
  reason String?
  status RefundStatus @default(COMPLETED)

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([hospitalId, invoiceId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Security / Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id      String   @id @default(uuid())

  // Null for events with no authenticated actor (e.g. failed login attempts).
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // Null for platform-level actions with no tenant context (e.g. SUPER_ADMIN
  // actions, or a failed login where the hospital could not be resolved).
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  action       String
  resourceType String?
  resourceId   String?
  outcome      AuditOutcome

  ipAddress     String?
  correlationId String?

  // Non-sensitive structured context only. Never store passwords, tokens,
  // OTPs, or clinical payloads here (see /SECURITY.md).
  metadata Json?

  createdAt DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}
